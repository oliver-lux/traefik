# ============================================
# TRAEFIK PRODUCTION ENVIRONMENT
# ============================================
# Copy: cp .env.production.example .env
# Then edit .env with your actual values!
# Usage: docker compose up -d
# ============================================

# ENVIRONMENT
ENVIRONMENT=production

# TIMEZONE
TZ=Europe/Berlin

# DASHBOARD
# Replace with your actual domain:
TRAEFIK_DASHBOARD_HOST=traefik.yourdomain.com
TRAEFIK_DASHBOARD_ENTRYPOINT=websecure

# Leave empty! -> secure
TRAEFIK_DASHBOARD_PORT=

# TLS
TRAEFIK_TLS_ENABLED=true
TRAEFIK_CERT_RESOLVER=letsencrypt

# AUTHENTICATION
# Generate password hash:
#   htpasswd -nbB admin yourpassword
# Or use online generator: https://hostingcanada.org/htpasswd-generator/
# IMPORTANT: Escape ALL $ characters as $$
# Example: admin:$2y$05$abc -> admin:$$2y$$05$$abc
TRAEFIK_DASHBOARD_MIDDLEWARES=dashboard-auth,security-headers
TRAEFIK_DASHBOARD_AUTH_USERS=admin:$$2y$$05$$abc

# LET'S ENCRYPT
# Replace with your actual email:
TRAEFIK_ACME_EMAIL=your-email@example.com

# LOGGING
TRAEFIK_LOG_LEVEL=WARN
