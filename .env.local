# ============================================
# TRAEFIK LOCAL DEVELOPMENT ENVIRONMENT
# ============================================
# Copy: cp .env.local.example .env
# Usage: docker compose --profile dev up -d
# ============================================

# ENVIRONMENT
ENVIRONMENT=development

# TIMEZONE
TZ=Europe/Berlin

# DASHBOARD
TRAEFIK_DASHBOARD_HOST=traefik.localhost
TRAEFIK_DASHBOARD_ENTRYPOINT=web
TRAEFIK_DASHBOARD_PORT=8080

# TLS (disabled for local)
TRAEFIK_TLS_ENABLED=false
TRAEFIK_CERT_RESOLVER=

# AUTHENTICATION (disabled for local)
TRAEFIK_DASHBOARD_MIDDLEWARES=
TRAEFIK_DASHBOARD_AUTH_USERS=

# LET'S ENCRYPT (not used locally)
TRAEFIK_ACME_EMAIL=

# LOGGING
TRAEFIK_LOG_LEVEL=DEBUG
