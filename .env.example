# Copy to .env and fill in:  cp .env.example .env

# Contact address for Let's Encrypt expiry notices (required).
ACME_EMAIL=admin@example.com

# Staging CA - use while testing DNS/ports to avoid the production rate limit
# (5 duplicate certs per week). Delete ./letsencrypt/acme.json when switching
# back to production, otherwise the staging certs are reused.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Hostname for the Traefik dashboard. Must resolve to this host; leave unset to
# keep the dashboard on traefik.localhost (not publicly routable).
TRAEFIK_DOMAIN=traefik.example.com

# Cert resolver for the dashboard router. Set to `letsencrypt` once TRAEFIK_DOMAIN
# is a real, publicly resolvable domain. Leave empty (default) while on
# traefik.localhost, otherwise Traefik retries ACME for a domain that can never
# validate and spams the log with rejectedIdentifier errors.
ACME_CERTRESOLVER=letsencrypt

# Basic auth for the dashboard (required). Generate with the $ doubled -
# Compose interpolates .env values, so a single $ is read as a variable
# reference and the bcrypt hash silently arrives truncated
# mkpasswd is part of the whois package on Debian/Ubuntu 
#
#   mkpasswd --method=bcrypt 'your-password' | sed 's/[$]/$$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2b$$05$$mZ6PTqyWfqjcz.0w5kNTmO.EfvVLEcgs/2zCMGYGgIJDBKyu1.0N.

TRAEFIK_LOG_LEVEL=INFO
TZ=Europe/Berlin
